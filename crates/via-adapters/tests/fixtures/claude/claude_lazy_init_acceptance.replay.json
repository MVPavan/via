        "line": "{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"id\":\"msg_01SYNTH000001\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"LAZY_OK\"}],\"usage\":{\"input_tokens\":7,\"output_tokens\":3}},\"parent_tool_use_id\":null,\"session_id\":\"${sid}\"}"
