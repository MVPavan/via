    {
      "emit": {
        "line": "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"session_id\":\"${sid}\",\"stop_reason\":\"end_turn\",\"terminal_reason\":\"completed\",\"num_turns\":1,\"total_cost_usd\":0.001,\"usage\":{\"input_tokens\":10,\"cache_creation_input_tokens\":100,\"cache_read_input_tokens\":1000,\"output_tokens\":20},\"permission_denials\":[],\"result\":\"LAZY_OK\"}"
